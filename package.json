{
  "name": "pdfly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,fastapi\" -c \"blue,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev -- -p 3001",
    "dev:backend": "cd backend && .venv\\Scripts\\python -m uvicorn backend.main:app --reload --port 8000",
    "dev:backend:global": "cd backend && python -m uvicorn backend.main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
